{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opencode",
  "experimental": {
    "disable_paste_summary": true
  },
  "plugin": [
    "opencode-notify",
    "@cortexkit/opencode-magic-context@0.42.6",
    "opencode-mermaid-renderer@0.0.1"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "cd *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh repo view *": "allow",
      "gh run view *": "allow",
      "gh search issues *": "allow",
      "gh search repos *": "allow",
      "git add *": "allow",
      "git branch --show-current*": "allow",
      "git checkout *": "allow",
      "git commit -m *": "allow",
      "git diff *": "allow",
      "git fetch *": "allow",
      "git log *": "allow",
      "git pull --ff-only *": "allow",
      "git remote -v *": "allow",
      "git rev-list *": "allow",
      "git show *": "allow",
      "git stash apply *": "allow",
      "git stash list *": "allow",
      "git stash pop *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "jira issue list *": "allow",
      "jira issue view *": "allow",
      "ls *": "allow",
      "npx -y gh-axi issue list *": "allow",
      "npx -y gh-axi issue view *": "allow",
      "npx -y gh-axi pr checks": "allow",
      "npx -y gh-axi pr diff *": "allow",
      "npx -y gh-axi pr list *": "allow",
      "npx -y gh-axi pr view *": "allow",
      "npx -y gh-axi release list *": "allow",
      "npx -y gh-axi release view *": "allow",
      "npx -y gh-axi repo view *": "allow",
      "npx -y gh-axi search *": "allow",
      "pwd *": "allow",
      "sort *": "allow",
      "tail *": "allow",
      "terraform init *": "allow",
      "terraform state list *": "allow",
      "terraform * validate *": "allow",
      "wc -l *": "allow",
      "xargs grep *": "allow",
      "rg *": "allow",
      "git push *": "ask",
      "find * -delete*": "ask",
      "find * -exec*": "ask",
      "cat *.env*": "deny",
      "grep *.env*": "deny",
      "rg *.env*": "deny",
      "head *.env*": "deny",
      "tail *.env*": "deny"
    },
    "edit": "ask",
    "write": "ask",
    "external_directory": {
      "*": "ask",
      "~/repos/**": "allow"
    },
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",
    "patch": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "datadog*": "deny",
    "glean*": "deny",
    "context7*": "deny",
    "grep_app*": "deny"
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "HAIP",
