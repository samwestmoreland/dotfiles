  },
  "mcp": {
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/v1/mcp?referrer_ide=opencode-plugin&plugin_version=0.7.13",
      "oauth": {}
    },
    "glean": {
      "type": "remote",
      "url": "{env:GLEAN_MCP_URL}",
      "oauth": {}
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  },
  "default_agent": "smarty",
  "agent": {
    "explore": {
      "model": "litellm/gpt-5.4"
    },
    "general": {
      "model": "litellm/claude-sonnet-4-6"
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  }
}
