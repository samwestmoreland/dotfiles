# Template for ~/.zsh_secrets — copy to ~/.zsh_secrets and fill in real values.
# The real ~/.zsh_secrets is NEVER committed (see .gitignore).
# ~/.zshrc sources it at startup.

# Artifactory
export ARTIFACTORY_TOKEN="..."
export ARTIFACTORY_DEV_TOKEN="..."

# Jira
export JIRA_API_TOKEN="..."

# LLM gateway
export HAIP_BASE_URL="https://your-llm-gateway.example.com"
export HAIP_API_KEY="sk-..."

# opencode config ({env:...} interpolation in ~/.config/opencode/opencode.json)
export LLM_API_KEY="sk-..."
export LLM_API_BASE_URL="https://your-llm-gateway.example.com/"
export GLEAN_MCP_URL="https://your-mcp-endpoint.example.com/mcp/default"
